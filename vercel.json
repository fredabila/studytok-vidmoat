{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "ignoreCommand": "if [ \"$VERCEL_GIT_COMMIT_REF\" = \"main\" ]; then exit 1; else exit 0; fi",
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "{content/**/pack.md,server/assets/fonts/**}"
    }
  },
  "redirects": [
    {
      "source": "/:path((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "studytok.vidmoat.com"
        }
      ],
      "destination": "https://study-graph.com/:path",
      "permanent": true
    },
    {
      "source": "/:path((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "studytok-vidmoat.vercel.app"
        }
      ],
      "destination": "https://study-graph.com/:path",
      "permanent": true
    },
    {
      "source": "/:path((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "www.study-graph.com"
        }
      ],
      "destination": "https://study-graph.com/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/@:handle",
      "destination": "/api/index?__path=c/:handle"
    },
    {
      "source": "/og/c/:file",
      "destination": "/api/index?__path=og/c/:file"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/index?__path=sitemap.xml"
    },
    {
      "source": "/og/v/:file",
      "destination": "/api/index?__path=og/v/:file"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index?__path=:path*"
    },
    {
      "source": "/v/:id",
      "destination": "/api/index?__path=v/:id"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; frame-src https://www.vidmoat.com; img-src 'self' https: data:; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/topup",
      "schedule": "17 4 * * *"
    },
    {
      "path": "/api/cron/remind",
      "schedule": "0 * * * *"
    }
  ]
}
