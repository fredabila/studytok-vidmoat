# --- Vidmoat (required) ------------------------------------------------------------
# Mint a key at https://developer.vidmoat.com/developer/apps. Server-side only.
# Scopes: account.read projects.read projects.write media.write render.read stock.read
# (the "Build & render" preset plus stock.read). A test key (vmk_test_...) is free and works:
# projects, edits, imports and the live player are all real with a test key.
VIDMOAT_API_KEY=vmk_test_replace_me

# Optional: file generated projects into a workspace, or delete each project once its
# document is cached (keeps your Vidmoat project list clean; you lose the editable original).
# VIDMOAT_WORKSPACE_ID=
# VIDMOAT_DELETE_PROJECTS=false

# --- Storage --------------------------------------------------------------------------
# Without these, data is kept in data/kv.json (fine for local development).
# On Vercel, adding Upstash Redis from the Marketplace sets KV_REST_API_URL / KV_REST_API_TOKEN
# automatically. UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN work too.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- Lessons & course research (strongly recommended) ------------------------------------
# With this, Claude writes progressive episodes for each syllabus unit (with diagrams and other
# teaching visuals) and researches courses that are not in the built-in catalog using web
# search. Without it, lessons come from the small offline bank (2 per topic).
# ANTHROPIC_API_KEY=sk-ant-...
# STUDYTOK_LESSON_MODEL=claude-opus-5-5
# STUDYTOK_LESSON_EFFORT=low
# STUDYTOK_EPISODES_PER_CALL=3        # episodes written per Claude call (queued for later videos)
# STUDYTOK_RESEARCH_MODEL=claude-opus-5-5
# STUDYTOK_RESEARCH_EFFORT=medium

# --- Voiceover (Vidmoat credits) ------------------------------------------------------------
# Narration costs 8 credits per video (Grok voice) + 5 for exact caption timing.
# STUDYTOK_VOICEOVER=true
# STUDYTOK_VOICE_ID=eve              # grok voices: eve, ara, leo, rex, sal
# STUDYTOK_VOICE_TIMING=exact        # or "estimated": 8 credits, answer shown but not spoken
# STUDYTOK_MIN_CREDITS=40            # below this balance, videos are made without narration

# --- Vercel Cron ------------------------------------------------------------------------------
# Set any random string; Vercel Cron sends it to /api/cron/topup to keep popular units stocked.
# CRON_SECRET=

# --- Feed tuning (optional) --------------------------------------------------------------
# PORT=3000
# HOST=127.0.0.1
# STUDYTOK_GEN_CONCURRENCY=2     # videos generated at once per server/function instance
# STUDYTOK_MUSIC=true            # CC0 stock music bed under each video
# STUDYTOK_SFX=true              # whoosh / pop / clock / ding sound effects
# STUDYTOK_READY_AHEAD=3         # videos generated ahead of each viewer
# STUDYTOK_GEN_RETRIES=1         # automatic retries for a failed generation
# STUDYTOK_REUSE_LIBRARY=true    # serve unseen library videos before generating new ones
# STUDYTOK_DATA_DIR=./data/
